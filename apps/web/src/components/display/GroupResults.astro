---
const { type, list } = Astro.props;
import { Icon } from "astro-icon/components";
import { IETFBCP47_TO_ALPHA2_MAP } from "@/data/languages";

if (!list || list.length === 0)
  return
---

<div
  class="grid grid-cols-[repeat(auto-fit,_minmax(min(384px,100%),_1fr))] gap-2 pt-2 mb-3"
>
  {
    list.map((group) => (
      <a href={`/${type === "Staff" ? "staff" : "publishers"}/${group.staff_id}`}>
        <div class="flex flex-col border-2 p-2 rounded-md bg-popover">
          <span class="truncate">
            <Icon
              name={`flag:${IETFBCP47_TO_ALPHA2_MAP[group.primary_language]}-4x3`}
              class="shadow inline mr-1 mb-1"
            />
            {group.aliases[0].name}
          </span>
        </div>
      </a>
    ))
  }
</div>
